{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Metaphyuni玄熊猫P1管理器",
  "version": "1.0.0",
  "identifier": "cn.metaphyuni.hub",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Metaphyuni玄熊猫P1管理器",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0f0f11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
